# --- Python ---
__pycache__/
*.py[cod]
.Python
*.egg-info/

# --- SPICE / simulation artifacts (regenerated on every run) ---
*.dat
*.raw
*.out
.spiceinit
spinit

# ngspice writes netlists here when driven from xschem
*.spice.bak

# --- generated plots ---
*.png
# ...except the report's figures, which ARE source: the document embeds them.
# The blanket *.png above is for regenerated simulation plots; without this
# exception `docs/figures/` would be silently dropped from every commit, which
# is how this repo nearly lost the trained policy checkpoint once already.
!docs/figures/*.png
# Same reasoning for the presentation's staged figures: they are what gets
# handed to the deck builder, so they are source, not output.
!docs/presentation/figures/*.png
*.svg
*.pdf

# --- editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# long-run operational files
logs/
models/*/ckpt_*
models/policy/ckpt_*.zip
# checkpoint 5's PPO weights, moved aside so the checkpoint-6
# cleanup does not sort them above a fresh run's low step counts
models/policy/ckpt5_ppo/
